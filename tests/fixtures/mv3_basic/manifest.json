{
  "manifest_version": 3,
  "name": "OriginWeave MV3 Compatibility Fixture",
  "version": "1.0.0",
  "description": "Deterministic local-only fixture for extension compatibility evidence.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "scripting",
    "sidePanel",
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "commands": {
    "originweave-fixture-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Exercise the OriginWeave MV3 commands API fixture"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "originweave_fixture_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
