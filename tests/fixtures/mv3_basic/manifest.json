{
  "manifest_version": 3,
  "name": "OriginWeave MV3 Compatibility Fixture",
  "version": "1.0.0",
  "description": "Deterministic local-only fixture for extension compatibility evidence.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "originweave_fixture_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
